  "hasPart": [
    {
      "@type": "SoftwareComponent",
      "name": "prolog-refactor-agent",
      "description": "Autonomous subagent for converting imperative Prolog to pure ISO Prolog."
    },
    {
      "@type": "SoftwareComponent",
      "name": "prolog-purity-reviewer-agent",
      "description": "Subagent for logical purity, reification (library(reif)), and Covington style auditing."
    },
    {
      "@type": "SoftwareComponent",
      "name": "prolog-security-reviewer-agent",
      "description": "Subagent for dynamic database safety, search bounds, and query injection prevention."
    },
    {
      "@type": "SoftwareComponent",
      "name": "prolog-clp-constraints",
      "description": "Agent skill for CLP(Z) and integer constraint programming."
    },
    {
      "@type": "SoftwareComponent",
      "name": "prolog-dcg-mastery",
      "description": "Agent skill for Definite Clause Grammars (DCG) and parser construction."
    },
    {
      "@type": "SoftwareComponent",
      "name": "prolog-library-discovery",
      "description": "Agent skill for discovering built-in and standard library predicates before generating code."
    }
  ],
